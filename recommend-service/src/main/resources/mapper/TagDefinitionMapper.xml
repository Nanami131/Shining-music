<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.L2.recommend.infrastructure.TagDefinitionMapper">

    <resultMap id="TagDefinitionResultMap" type="org.L2.recommend.domain.model.TagDefinition">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="category" column="category"/>
        <result property="labelZh" column="label_zh"/>
        <result property="dimIndex" column="dim_index"/>
        <result property="valueType" column="value_type"/>
        <result property="enumValues" column="enum_values"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectAllOrderByDimIndex" resultMap="TagDefinitionResultMap">
        SELECT * FROM tag_definitions ORDER BY dim_index ASC
    </select>

    <select id="selectById" resultMap="TagDefinitionResultMap">
        SELECT * FROM tag_definitions WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="TagDefinitionResultMap">
        SELECT * FROM tag_definitions WHERE name = #{name}
    </select>

    <insert id="insert" parameterType="org.L2.recommend.domain.model.TagDefinition" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag_definitions (name, category, label_zh, dim_index, value_type, enum_values, created_at)
        VALUES (#{name}, #{category}, #{labelZh}, #{dimIndex}, #{valueType}, #{enumValues}, #{createdAt})
    </insert>

    <update id="update" parameterType="org.L2.recommend.domain.model.TagDefinition">
        UPDATE tag_definitions
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="labelZh != null">label_zh = #{labelZh},</if>
            <if test="dimIndex != null">dim_index = #{dimIndex},</if>
            <if test="valueType != null and valueType != ''">value_type = #{valueType},</if>
            <if test="enumValues != null">enum_values = #{enumValues},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectMaxDimIndex" resultType="java.lang.Integer">
        SELECT MAX(dim_index) FROM tag_definitions
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM tag_definitions
    </select>

</mapper>
