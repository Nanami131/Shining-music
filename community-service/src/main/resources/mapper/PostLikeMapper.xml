<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.L2.community.infrastructure.mapper.PostLikeMapper">

    <resultMap id="PostLikeResultMap" type="org.L2.community.domain.model.PostLike">
        <id     column="id"         property="id"/>
        <result column="post_id"    property="postId"/>
        <result column="user_id"    property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert"
            parameterType="org.L2.community.domain.model.PostLike"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO post_likes (post_id, user_id)
        VALUES (#{postId}, #{userId})
    </insert>

    <delete id="delete">
        DELETE FROM post_likes
        WHERE post_id = #{postId} AND user_id = #{userId}
    </delete>

    <select id="selectByPair" resultMap="PostLikeResultMap">
        SELECT id, post_id, user_id, created_at
        FROM post_likes
        WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <select id="countByPost" resultType="int">
        SELECT COUNT(*) FROM post_likes WHERE post_id = #{postId}
    </select>
</mapper>
